APP_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
OPEN_BROWSER=true
LOG_LEVEL=INFO
MODEL_PATH=ml_model/sla_model.joblib
DATA_PATH=data/tickets.csv
DATABASE_PATH=data/platform.db
# Required when APP_ENV=production. Keep only in .env or your secret manager.
AUTH_SECRET_KEY=
LOGIN_RATE_LIMIT=10
PREDICTION_RATE_LIMIT=60
JIRA_IMPORT_RATE_LIMIT=20
# Used only by `python -m src.cli bootstrap-admin`; never expose these over HTTP.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional recruiter demo. When both are set, app startup creates the admin once
# and idempotently seeds the DEMO-* sample tickets. Keep the password private.
DEMO_ADMIN_EMAIL=demo.admin@ticketroute.local
DEMO_ADMIN_PASSWORD=
# Priority-based SLA targets in elapsed hours. These are demo defaults; replace
# them with your approved service policy before relying on the assessment.
SLA_TARGET_CRITICAL_HOURS=1
SLA_TARGET_HIGH_HOURS=4
SLA_TARGET_MEDIUM_HOURS=8
SLA_TARGET_LOW_HOURS=24
SLA_WARNING_FRACTION_PERCENT=25
# Optional private, local project assistant. Install Ollama and pull the model
# before enabling interactive LLM answers. No ticket data is sent off-device.
SUPPORT_LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=90
# Optional future live JIRA configuration. Mock ingestion requires no credentials.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
